FROM node:22-bookworm-slim AS dependencies

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential python3 git ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY scripts/prepare-pty.mjs scripts/prepare-pty.mjs
RUN npm ci

FROM node:22-bookworm-slim AS runtime

ARG CODEX_VERSION=0.155.1
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates tini \
  && rm -rf /var/lib/apt/lists/* \
  && npm install --global "@openai/codex@${CODEX_VERSION}" \
  && codex --version

WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4000 CODEX_EXECUTABLE=/usr/local/bin/codex

COPY --from=dependencies /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/package.json
COPY apps/server/src apps/server/src
COPY packages/shared/package.json packages/shared/package.json
COPY packages/shared/src packages/shared/src
COPY scripts/setup-demo.mjs scripts/setup-demo.mjs
COPY samples/demo samples/demo

RUN mkdir -p /app/.runtime && chown -R node:node /app
USER node

VOLUME ["/app/.runtime"]
EXPOSE 4000
HEALTHCHECK --interval=20s --timeout=3s --start-period=20s --retries=3 CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "node scripts/setup-demo.mjs && exec node node_modules/tsx/dist/cli.mjs apps/server/src/index.ts"]
