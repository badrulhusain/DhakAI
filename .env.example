# Paths are relative to the project root, or absolute. Defaults work with demo:setup.
TARGET_REPO=.runtime/demo-repo
WORKTREE_ROOT=.runtime/worktrees
CODEX_EXECUTABLE=codex
PORT=4000
WEB_PORT=3000
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# The root service command derives NEXT_PUBLIC_BACKEND_URL from PORT.

# Choose explicitly. Local is durable JSON for development; Supabase never silently falls back.
STORAGE_MODE=local
DATA_ROOT=.runtime/data
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-server-only-secret-key

# Optional and disabled by default. This loopback demo has no accounts or teacher roles.
ENABLE_DEMO_REVIEWER_MODE=false

# Codex-run quizzes use Groq. Demo runs always use bundled deterministic questions.
# GROQ_API_KEY=your-server-only-groq-key
GROQ_MODEL=openai/gpt-oss-120b

# Optional post-merge validation. The executable and arguments are server-owned.
# MERGE_VALIDATION_EXECUTABLE=npm
# MERGE_VALIDATION_ARGS_JSON=["test"]
